package main

// Potion Workshop pane header: paper with grain and a stitched line.

var Dark float
var Origin vec2

func hash(p vec2) float {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453)
}

func Fragment(dst vec4, pos vec2) vec4 {
	s := rectSize()
	wp := pos + Origin
	c := mix(vec3(1.0, 0.953, 0.84), vec3(0.27, 0.17, 0.10), Dark)
	fb := sin(wp.y*0.9+sin(wp.x*0.023)*5.0)
	c *= 1 - 0.007*fb
	c += (hash(floor(wp)) - 0.5) * 0.03
	// A dashed stitch above the bottom edge.
	b := s.y - pos.y
	if b > 2.5 && b < 3.7 && fract(pos.x/7) < 0.55 {
		c = mix(vec3(0.885, 0.80, 0.655), vec3(0.45, 0.31, 0.18), Dark)
	}
	return vec4(clamp(c, 0, 1), 1)
}
