package main

// Potion Workshop background, the paper layer: parchment lighter in the
// middle and darker at the edges, a warm lamp glow and large soft stains.
// The grain layer and the props layer draw over it.

var Dark float
var Origin, Window vec2

// The paper between the middle and the edges.
//gorex:param color #f1e2c2/#332014
var Paper vec3

// The paper in the middle of the window.
//gorex:param color #f9edd4/#40291a
var Center vec3

// The paper at the edges of the window.
//gorex:param color #cca875/#1a0f09
var Edge vec3

// The color of the lamp glow.
//gorex:param color #fff2d1/#6b3d1c
var LampColor vec3

// Where the lamp glow sits in the window.
//gorex:param point 0.3 0.25
var Lamp vec2

// How strong the lamp glow is.
//gorex:param number 1 0 1.5
var LampStrength float

// How dark the large soft stains are.
//gorex:param number 0.035 0 0.08
var Stains float

func Fragment(dst vec4, pos vec2) vec4 {
	wp := pos + Origin
	uv := wp / Window
	d := length((uv - vec2(0.45, 0.42)) * vec2(1.1, 1.0))
	col := mix(Center, Paper, clamp(d*1.6, 0, 1))
	col = mix(col, Edge, clamp((d-0.45)*1.4, 0, 1))
	lg := clamp(1-length((uv-Lamp)*vec2(1.0, 1.3))*1.5, 0, 1)
	col = mix(col, LampColor, clamp(lg*lg*mix(0.35, 0.6, Dark)*LampStrength, 0, 1))
	st := sin(wp.x*0.0071+wp.y*0.0033) * sin(wp.y*0.0083-wp.x*0.0029)
	col *= 1 - Stains*st
	return vec4(clamp(col, 0, 1), 1)
}
