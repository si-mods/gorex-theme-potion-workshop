package main

// Potion Workshop chosen row: paper with grain and a stitched edge.

var Dark float
var Origin vec2

func hash(p vec2) float {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453)
}

func Fragment(dst vec4, pos vec2) vec4 {
	s := rectSize()
	wp := pos + Origin
	c := mix(vec3(1.0, 0.973, 0.91), vec3(0.30, 0.19, 0.115), Dark)
	fb := sin(wp.y*0.9+sin(wp.x*0.023)*5.0)
	c *= 1 - 0.007*fb
	c += (hash(floor(wp)) - 0.5) * 0.03
	// A dashed stitch 1 DIP inside the edge, where no text sits.
	e := min(min(pos.x, s.x-pos.x), min(pos.y, s.y-pos.y))
	along := pos.x + pos.y
	if e > 0.8 && e < 2 && fract(along/7) < 0.55 {
		c = mix(vec3(0.66, 0.50, 0.32), vec3(0.66, 0.48, 0.29), Dark)
	}
	return vec4(clamp(c, 0, 1), 1)
}
